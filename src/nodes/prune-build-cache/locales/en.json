{
  "nodes": {
    "prune-build-cache": {
      "name": "Prune Build Cache",
      "description": "Clear the Docker build cache to free disk space",
      "summary": {
        "pruned": "{count} entries · {size} MB"
      }
    }
  },
  "config": {
    "pruneBuildCacheAll": "Remove All Cache",
    "pruneBuildCacheKeepStorage": "Keep Storage",
    "pruneBuildCacheFilter": "Filter",
    "pruneBuildCacheKeepStoragePlaceholder": "10GB",
    "pruneBuildCacheFilterPlaceholder": "until=24h"
  }
}
