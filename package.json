{
  "name": "@nexploy/nodes",
  "version": "0.1.0",
  "description": "Pipeline node library for Nexploy \u2014 descriptors, executors and configuration panels.",
  "license": "GPL-3.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./ui/*": {
      "types": "./dist/ui/*.d.ts",
      "default": "./dist/ui/*.js"
    },
    "./vendor/*": {
      "types": "./dist/vendor/*.d.ts",
      "default": "./dist/vendor/*.js"
    },
    "./registry/*": {
      "types": "./dist/nodes/registry/*.d.ts",
      "default": "./dist/nodes/registry/*.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "pnpm run vendor && rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run vendor && tsc --noEmit",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ky": "^1.14.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.11.1",
    "dayjs": "^1.11.19",
    "dockerode": "^5.0.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "next-intl": "^4.9.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@xyflow/react": "^12.11.1",
    "dayjs": "^1.11.19",
    "dockerode": "^5.0.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "next-intl": "^4.9.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "typescript": "7.0.2",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22.13"
  }
}
