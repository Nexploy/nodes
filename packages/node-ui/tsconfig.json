{
  "extends": "@nexploy/typescript-config/react-library.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@nexploy/node-ui/*": ["./src/*"],
      "@nexploy/node-core/*": ["../node-core/src/*"],
      "@workspace/ui/*": ["../../../nexploy/packages/ui/src/*"]
    },
    "types": ["node", "react"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
