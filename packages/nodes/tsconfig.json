{
  "extends": "@nexploy/typescript-config/bundler-library.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["node", "react"],
    "paths": {
      "@nexploy/node-core/*": ["../node-core/src/*"],
      "@nexploy/node-ui/*": ["../node-ui/src/*"],
      "@workspace/ui/*": ["../../../nexploy/packages/ui/src/*"],
      "@workspace/shared/*": ["../../../nexploy/packages/shared/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
